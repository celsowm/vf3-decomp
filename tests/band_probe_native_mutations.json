 {
  "name": "the_high_bound_is_tested_second",
  "subs": [
   [
    "    const int above = (value > high);\n    set_t(a, above);\n    if (above) return 0;\n    const int at_least = (value >= low);\n    set_t(a, at_least);\n    return at_least;",
    "    const int below = (value < low);\n    set_t(a, below);\n    if (below) return 0;\n    const int at_most = (value <= high);\n    set_t(a, at_most);\n    return at_most;"
   ]
  ]
 },
